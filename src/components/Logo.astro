---
// Logo Carfly, versiunea mică (fără marcaj și ferestre), pentru antet.
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="logo" href={href} aria-label={label}>
  <span>carfly</span>
  <svg width="104" height="22" viewBox="0 -12 240 50" aria-hidden="true">
    <path transform="translate(15 -3) rotate(128) translate(-12 -12)" d="M12 2 C12.8 2 13.3 2.8 13.3 4 L13.3 9 L21 13.5 L21 15.5 L13.3 13 L13.3 18 L15.5 19.8 L15.5 21.3 L12 20.3 L8.5 21.3 L8.5 19.8 L10.7 18 L10.7 13 L3 15.5 L3 13.5 L10.7 9 L10.7 4 C10.7 2.8 11.2 2 12 2 Z" fill="#CC8F00"></path>
    <path d="M24 1 Q52 22 80 24 L180 24 A6 6 0 0 1 180 36 L80 36 Q48 33 20 6 Z" fill="#0E2A47"></path>
    <g transform="translate(193 5) scale(1.3)">
      <path d="M1 10.6 V5.4 C1 4.6 1.5 4 2.3 3.9 L5.6 3.6 L8 1 C8.5 0.5 9.2 0.2 10 0.2 L20.2 0.2 C21 0.2 21.7 0.5 22.2 1.1 L26.4 5 L33 6 C34.2 6.2 35 7.2 35 8.4 V10.6 C35 11.2 34.6 11.6 34 11.6 H2 C1.4 11.6 1 11.2 1 10.6 Z" fill="#CC8F00"></path>
      <circle cx="8.5" cy="11.6" r="3.4" fill="#0E2A47"></circle>
      <circle cx="27.5" cy="11.6" r="3.4" fill="#0E2A47"></circle>
    </g>
  </svg>
</a>
